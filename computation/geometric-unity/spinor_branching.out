=== B0. Dimensions ===
D2: dim S+ = 2, dim S- = 2, dim V = 4, dim R+ = 6, dim R- = 6
D5: dim S+ = 16, dim S- = 16, dim V = 10, dim R+ = 144, dim R- = 144
D7: dim S+ = 64, dim S- = 64, dim V = 14, dim R+ = 832, dim R- = 832

=== B1. Spin(14) -> Spin(4) x Spin(10) (complexified Spin(7,7) -> Spin(1,3) x Spin(6,4)) ===
S+(14) [dim 64] -> (2+=(2,1) x 16+) + (2-=(1,2) x 16-)
S-(14) [dim 64] -> (2+=(2,1) x 16-) + (2-=(1,2) x 16+)
V(14) [dim 14] -> (1 x 10) + (4=(2,2) x 1)
R+(14) [dim 832] -> (6+=(3,2) x 16+) + (6-=(2,3) x 16-) + (2+=(2,1) x 144+) + (2+=(2,1) x 16-) + (2-=(1,2) x 144-) + (2-=(1,2) x 16+)
R-(14) [dim 832] -> (6+=(3,2) x 16-) + (6-=(2,3) x 16+) + (2+=(2,1) x 144-) + (2+=(2,1) x 16+) + (2-=(1,2) x 144+) + (2-=(1,2) x 16-)

=== B2. Field content nu in Omega^0(S^a), zeta in Omega^1(S^b): count of spin-1/2 x 16 pieces ===
  zeta = V(x)S- [dim 896] -> (6+=(3,2) x 16-) + (6-=(2,3) x 16+) + (2+=(2,1) x 144-) + 2*(2+=(2,1) x 16+) + (2-=(1,2) x 144+) + 2*(2-=(1,2) x 16-)
  nu in S+, zeta in V(x)S-: #(2+x16+ or 2-x16-) = 6, #(2+x16- or 2-x16+) = 0
  zeta = V(x)S+ [dim 896] -> (6+=(3,2) x 16+) + (6-=(2,3) x 16-) + (2+=(2,1) x 144+) + 2*(2+=(2,1) x 16-) + (2-=(1,2) x 144-) + 2*(2-=(1,2) x 16+)
  nu in S+, zeta in V(x)S+: #(2+x16+ or 2-x16-) = 2, #(2+x16- or 2-x16+) = 4

=== B3. Spin(10) -> Pati-Salam SU(4) x SU(2)_L x SU(2)_R ===
  16+ -> (4,2,1) + (4b,1,2)
  16- -> (4,1,2) + (4b,2,1)
   10 -> (1,2,2) + (6,1,1)
 144+ -> (20,2,1) + (20b,1,2) + (4,1,2) + (4,3,2) + (4b,2,1) + (4b,2,3)
 144- -> (20,1,2) + (20b,2,1) + (4,2,1) + (4,2,3) + (4b,1,2) + (4b,3,2)

=== B4. Spin(10) -> SU(3) x SU(2)_L x U(1)_Y, entries [SU3 x SU2]^{n = 6Y} ===
  16+: [1x1]^+6, [3bx1]^+2, [3x2]^+1, [1x1]^+0, [1x2]^-3, [3bx1]^-4
  16-: [3x1]^+4, [1x2]^+3, [1x1]^+0, [3bx2]^-1, [3x1]^-2, [1x1]^-6
   10: [1x2]^+3, [3bx1]^+2, [3x1]^-2, [1x2]^-3
 144+: [1x2]^+9, [3bx1]^+8, [3bx2]^+5, [3x1]^+4 x2, [3x3]^+4, [6bx1]^+4, [1x2]^+3 x2, [8x2]^+3, [3bx1]^+2, [1x1]^+0, [1x3]^+0, [8x1]^+0, [3bx2]^-1 x3, [6x2]^-1, [3x1]^-2 x2, [3x3]^-2, [6bx1]^-2, [1x2]^-3, [3x2]^-5, [1x1]^-6, [1x3]^-6, [8x1]^-6, [3bx2]^-7
 144-: [3x2]^+7, [1x1]^+6, [1x3]^+6, [8x1]^+6, [3bx2]^+5, [1x2]^+3, [3bx1]^+2 x2, [3bx3]^+2, [6x1]^+2, [3x2]^+1 x3, [6bx2]^+1, [1x1]^+0, [1x3]^+0, [8x1]^+0, [3x1]^-2, [1x2]^-3 x2, [8x2]^-3, [3bx1]^-4 x2, [3bx3]^-4, [6x1]^-4, [3x2]^-5, [3x1]^-8, [1x2]^-9

