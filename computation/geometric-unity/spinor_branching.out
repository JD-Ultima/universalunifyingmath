source 144 table == SM content of 144+: False
   in source not ours: {('8', 2, -3): 1, ('8', 1, 6): 1, ('6b', 2, 1): 1, ('6', 1, 2): 1, ('6', 1, -4): 1, ('3b', 3, 2): 1, ('3b', 3, -4): 1, ('3', 2, 7): 1, ('3', 2, 1): 3, ('3', 1, -8): 1, ('3b', 1, 2): 1, ('3b', 1, -4): 2, ('1', 3, 6): 1, ('1', 2, -9): 1, ('1', 2, -3): 1, ('1', 1, 6): 1}
   in ours not source: {('1', 2, 9): 1, ('3b', 1, 8): 1, ('6b', 1, 4): 1, ('3', 3, 4): 1, ('3', 1, 4): 2, ('8', 2, 3): 1, ('1', 2, 3): 1, ('6', 2, -1): 1, ('3b', 2, -1): 3, ('6b', 1, -2): 1, ('3', 3, -2): 1, ('3', 1, -2): 1, ('8', 1, -6): 1, ('1', 3, -6): 1, ('1', 1, -6): 1, ('3b', 2, -7): 1}
source 144 table == SM content of 144-: True
electric charges in 144- blocks (Q = T3 + n/6):
   [1x3]^+0 x1: Q = 1, 0, -1
   [1x3]^+6 x1: Q = 2, 1, 0
   [1x2]^-9 x1: Q = -1, -2
   [1x2]^-3 x2: Q = 0, -1
   [1x2]^+3 x1: Q = 1, 0
   [1x1]^+0 x1: Q = 0
   [1x1]^+6 x1: Q = 1
   [3x2]^-5 x1: Q = -1/3, -4/3
   [3x2]^+1 x3: Q = 2/3, -1/3
   [3x2]^+7 x1: Q = 5/3, 2/3
   [3x1]^-8 x1: Q = -4/3
   [3x1]^-2 x1: Q = -1/3
   [3bx3]^-4 x1: Q = 1/3, -2/3, -5/3
   [3bx3]^+2 x1: Q = 4/3, 1/3, -2/3
   [3bx2]^+5 x1: Q = 4/3, 1/3
