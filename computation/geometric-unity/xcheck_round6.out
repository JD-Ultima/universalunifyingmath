     base (1, 1, -1, -1): R.h traceless: True;  F(e_a, e_b; h) not identically 0 for (a,b) in [(0, 0), (0, 1), (0, 2), (0, 3), (1, 1), (1, 2), (1, 3), (2, 2), (2, 3), (3, 3)];  F(e0,e0) = 4*(3*h1**2 - 3*h2**2 - 3*h3**2 + 3*h4**2 - 5*h4*h7 - 5*h4*h9 - h5**2 - h6**2 + 3*h7**2 + 5*h7*h9 + h8**2 + 3*h9**2)
