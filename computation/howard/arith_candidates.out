  ab+min(a,b): LD:{'a': 0, 'b': 2, 'c': -1}; RD:{'a': -2, 'b': 1, 'c': 0}; AS:{'a': 1, 'b': 0, 'c': -1}; INC:{'a': 1, 'b': 1/2}; BAL:{'a': 1, 'b': 1/2}
  2b (left-only): RD:{'a': 0, 'b': 0, 'c': -1}; AS:{'a': 0, 'b': 0, 'c': -1}; CM:{'a': 1/4, 'b': 0}; INC:{'a': 1/2, 'b': 1/4}; BAL:{'a': 2, 'b': 1}
